// =====================================================================
// SILVER — gastos_silver: tipado, normalizado (v1 → v2), monto real y conversión a PEN.
// Se llena en tiempo real con una Update Policy sobre raw_gastos.
// =====================================================================

// Tipo de cambio (tabla pequeña; se actualiza a mano o con un pipeline diario)
.create-merge table tipo_cambio (
    fecha: datetime,
    moneda: string,
    pen_por_unidad: real
)

.alter table tipo_cambio folder "silver"

// Semilla idempotente: PEN = 1 (el USD se carga con el valor del día; 3.75 es solo el fallback de la función)
.set-or-append tipo_cambio <|
    datatable(fecha: datetime, moneda: string, pen_por_unidad: real) [datetime(2026-01-01), "PEN", 1.0]
    | where toscalar(tipo_cambio | where moneda == "PEN" | count) == 0

.create-merge table gastos_silver (
    id: string,
    op_type: string,
    version: int,
    version_timestamp: datetime,
    schema_version: int,
    fecha_registro: datetime,
    fecha_gasto: datetime,
    categoria: string,
    concepto: string,
    tipo_gasto: string,
    metodo_pago: string,
    entidad_financiera: string,
    moneda: string,
    cantidad: real,
    monto_total: real,
    monto_propio: real,
    monto_real: real,
    por_cobrar: real,
    es_compartido: bool,
    liquidado: bool,
    pen_por_unidad: real,
    monto_real_pen: real,
    encolado_en: datetime,
    ingestado_en: datetime
)

.alter table gastos_silver folder "silver"

.alter table gastos_silver docstring "Eventos de gastos limpios y tipados (todas las versiones; ver gastos_ultima_version)"

// IMPORTANTE: raw_gastos recibe ingesta en STREAMING desde el Eventstream. Con streaming, la update policy
// NO puede consultar otras tablas (join/lookup) ni usar ingestion_time() → "Request is invalid".
// Por eso: now() marca la ingesta y la conversión USD→PEN se hace en Gold (fn_gastos_actuales) con tipo_cambio.
.create-or-alter function with (folder = "silver", docstring = "Transformación Bronze → Silver (update policy, apta para streaming)")
fn_gastos_silver() {
    raw_gastos
    | where isnotempty(id)                                             // calidad: sin id no hay gasto
    | extend op = iff(isempty(op_type), "INSERT", toupper(op_type)),  // v1 no traía op_type
             registro = todatetime(fecha_registro),
             es_comp = coalesce(es_compartido, false)
    | where op in ("INSERT", "UPDATE", "DELETE")
    | extend propio = iff(es_comp, monto_propio, real(null))
    | extend real_ = iff(isnull(propio), monto_total, propio),
             liq = coalesce(liquidado, false)
    | extend tasa = iff(moneda == "PEN", 1.0, real(null))             // USD: se resuelve en Gold
    | project id,
              op_type           = op,
              version           = toint(coalesce(version, 1)),
              version_timestamp = coalesce(todatetime(version_timestamp), registro),
              schema_version    = toint(coalesce(schema_version, 1)),
              fecha_registro    = registro,
              fecha_gasto       = todatetime(fecha_gasto),
              categoria, concepto, tipo_gasto, metodo_pago, entidad_financiera, moneda, cantidad, monto_total,
              monto_propio      = propio,
              monto_real        = real_,
              por_cobrar        = iff(es_comp and not(liq), monto_total - real_, 0.0),
              es_compartido     = es_comp,
              liquidado         = liq,
              pen_por_unidad    = tasa,
              monto_real_pen    = round(real_ * tasa, 2),
              encolado_en       = EventEnqueuedUtcTime,
              ingestado_en      = now()
}

// Update policy: cada fila nueva en Bronze se transforma y se escribe en Silver en la misma transacción
.alter table gastos_silver policy update
```
[{
  "IsEnabled": true,
  "Source": "raw_gastos",
  "Query": "fn_gastos_silver()",
  "IsTransactional": true,
  "PropagateIngestionProperties": false
}]
```

// Backfill de lo que ya estaba en Bronze antes de crear la policy: solo si Silver está vacía (idempotente)
.set-or-append gastos_silver <|
    fn_gastos_silver()
    | where toscalar(gastos_silver | count) == 0
