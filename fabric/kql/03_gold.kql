// =====================================================================
// GOLD — estado actual de cada gasto (dedupe CDC) y vistas de negocio.
// OneLake availability expone gastos_silver como Delta en el Lakehouse → Power BI Direct Lake.
// =====================================================================

// Estado actual por gasto: la última versión gana (resuelve duplicados por reintentos y desorden)
// "ifnotexists": backfill solo es válido al crear; así el script es re-ejecutable en TEST y PRD
.create ifnotexists materialized-view with (backfill = true, folder = "gold",
    docstring = "Última versión de cada gasto (incluye DELETE; filtrar con fn_gastos_actuales)")
gastos_ultima_version on table gastos_silver
{
    gastos_silver
    | summarize arg_max(version_timestamp, *) by id
}

.create-or-alter function with (folder = "gold", docstring = "Gastos vigentes (sin borrados), con montos convertidos a PEN")
fn_gastos_actuales() {
    // Conversión a PEN aquí (no en Silver): la update policy en streaming no puede hacer lookup
    let tc = tipo_cambio | summarize arg_max(fecha, pen_por_unidad) by moneda | project moneda, tc = pen_por_unidad;
    // Dueño del gasto: no cambia nunca, así que basta el último evento que lo trae. Se resuelve aquí (y no en la
    // vista materializada, cuyo esquema quedó fijo al crearla) para no tener que recrearla.
    let duenos = gastos_silver | where isnotempty(usuario_id) | summarize arg_max(version_timestamp, usuario_id) by id
                 | project id, dueno = usuario_id;
    gastos_ultima_version   // por nombre = parte materializada + delta reciente (siempre al día)
    | where op_type != "DELETE"
    | lookup kind = leftouter tc on moneda
    | lookup kind = leftouter duenos on id
    | extend pen_por_unidad = coalesce(pen_por_unidad, tc, 3.75)
    | extend monto_real_pen = coalesce(monto_real_pen, round(monto_real * pen_por_unidad, 2))
    | project-away tc
    | extend usuario_id = coalesce(dueno, "")
    | project-away dueno
}

.create-or-alter function with (folder = "gold", docstring = "KPIs del mes en curso (hora Lima) en PEN, por usuario (parámetro opcional: un usuario_id)")
fn_kpis_mes(usuario: string = "") {
    let inicio = startofmonth(datetime_utc_to_local(now(), "America/Lima"));
    fn_gastos_actuales()
    | where fecha_gasto >= inicio and (isempty(usuario) or usuario_id == usuario)
    | summarize gasto_real_pen = sum(monto_real_pen),
                hormiga_pen    = sumif(monto_real_pen, tipo_gasto == "Variable Hormiga"),
                por_cobrar_pen = sum(por_cobrar * pen_por_unidad),
                n              = count()
                by usuario_id
    | extend pct_hormiga = round(100.0 * hormiga_pen / gasto_real_pen, 1)
}

.create-or-alter function with (folder = "gold", docstring = "Gasto diario vs promedio móvil de 30 días")
fn_gasto_diario(dias: int = 90, usuario: string = "") {
    fn_gastos_actuales()
    | where fecha_gasto > ago(dias * 1d) and (isempty(usuario) or usuario_id == usuario)
    | make-series gasto_pen = sum(monto_real_pen) default = 0 on fecha_gasto step 1d
    | extend promedio_30d = series_fir(gasto_pen, repeat(1, 30), true, false)   // media móvil 30 días
    | mv-expand dia = fecha_gasto to typeof(datetime), gasto_pen to typeof(real), promedio_30d to typeof(real)
    | extend anomalia = gasto_pen > 2 * promedio_30d and promedio_30d > 0
    | project dia, gasto_pen, promedio_30d, anomalia
}

// Habilitar OneLake availability (Silver → Delta en OneLake, para el Lakehouse y Direct Lake)
.alter-merge table gastos_silver policy mirroring dataformat = parquet with (IsEnabled = true)
