// =====================================================================
// BRONZE — raw_gastos: una fila por evento, tal como lo escribe el destino Eventhouse del Eventstream
// ("event processing before ingestion": columnas por nombre de campo JSON + columnas de sistema).
// Append-only e inmutable: aquí NO se tipa ni se limpia (eso es Silver).
// Idempotente: se puede re-ejecutar en TEST y PRD.
// =====================================================================

// Esquema v1 (creado por el Eventstream) + campos v2 de la outbox (op_type, version, ...).
// .create-merge solo agrega lo que falte; los tipos de las columnas existentes deben coincidir.
.create-merge table raw_gastos (
    id: string,
    fecha_registro: string,
    fecha_gasto: string,
    categoria: string,
    concepto: string,
    tipo_gasto: string,
    metodo_pago: string,
    entidad_financiera: string,
    moneda: string,
    cantidad: real,
    monto_total: real,
    es_compartido: bool,
    EventProcessedUtcTime: datetime,
    PartitionId: long,
    EventEnqueuedUtcTime: datetime,
    op_type: string,
    version: int,
    version_timestamp: string,
    schema_version: int,
    monto_propio: real,
    liquidado: bool
)

.alter table raw_gastos docstring "Eventos crudos de gastos desde Fabric Eventstream (append-only, contrato v1 y v2)"

.alter table raw_gastos folder "bronze"

// Bronze conserva todo el historial (auditoría / replay)
.alter-merge table raw_gastos policy retention softdelete = 3650d recoverability = enabled
